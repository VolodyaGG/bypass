[Unit]
Description=VPN-Forge OpenFlux exit-node
Documentation=https://github.com/p1neappleXpress/OpenFlux
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
{% if openflux.mode == 'raw' %}
User=root
{% endif %}
ExecStart={{ openflux.argv | join(' ') }}
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
