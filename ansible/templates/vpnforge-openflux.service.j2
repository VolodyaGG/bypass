[Unit]
Description=bypass OpenFlux exit-node
Documentation=https://github.com/p1neappleXpress/OpenFlux
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
{% if openflux.mode == 'l3' %}
User=root
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
ExecStartPre=/bin/sh -c '/usr/sbin/iptables -C OUTPUT -p tcp --tcp-flags RST RST -m mark ! --mark 0x2547 -j DROP 2>/dev/null || /usr/sbin/iptables -A OUTPUT -p tcp --tcp-flags RST RST -m mark ! --mark 0x2547 -j DROP'
ExecStopPost=-/usr/sbin/iptables -D OUTPUT -p tcp --tcp-flags RST RST -m mark ! --mark 0x2547 -j DROP
{% endif %}
ExecStart={{ openflux.argv | map('quote') | join(' ') }}
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
