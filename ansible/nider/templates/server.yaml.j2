listen: 0.0.0.0:24443
tls:
  cert: /etc/hysteria2-nider/server.crt
  key: /etc/hysteria2-nider/server.key
auth:
  type: command
  command: /usr/local/lib/hysteria2-nider/authenticate
obfs:
  type: salamander
  salamander:
    password: {{ hy_obfs | to_json }}
masquerade:
  type: string
  string:
    content: "Welcome"
    headers:
      content-type: text/plain
    statusCode: 200
